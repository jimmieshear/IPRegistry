@HOSTNAME@ {
	encode zstd gzip

	# Two audiences, two auth schemes. Reporters POST to /report with a bearer token,
	# so that path passes straight through. Everything else is a human with a browser
	# and gets a normal password prompt — which keeps your internal network inventory
	# off the public web without forcing you to inject headers by hand.
	@dashboard not path /report
	basic_auth @dashboard {
		@USERNAME@ @PASSWORD_HASH@
	}

	# The collector listens only on loopback. Caddy adds X-Forwarded-For, which the
	# collector trusts precisely because nothing else can reach it.
	reverse_proxy 127.0.0.1:@PORT@

	# Access log to the journal rather than a file under /var/log/caddy. A file needs a
	# directory Caddy's own user can write, which depends on both ownership and whatever
	# ProtectSystem the packaged unit ships — and `caddy validate` does not check either,
	# so a permission problem only surfaces as a failed start. journalctl -u caddy works
	# regardless.
	log {
		output stderr
	}
}
